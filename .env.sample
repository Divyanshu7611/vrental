# Membership expiry cron (runs inside server.js — no Linux crontab required)
# Production: enabled by default. Dev: set ENABLE_MEMBERSHIP_EXPIRY_CRON=true to test.
# ENABLE_MEMBERSHIP_EXPIRY_CRON=false
# MEMBERSHIP_EXPIRY_CRON_SCHEDULE=0 * * * *
# MEMBERSHIP_CRON_INTERNAL_BASE_URL=http://127.0.0.1:3000
# MEMBERSHIP_EXPIRY_CRON_RUN_ON_START=false